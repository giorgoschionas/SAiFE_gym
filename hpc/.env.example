# Copy this file to hpc/.env, edit it, and source it from the checkout root
# before running setup or sbatch. hpc/.env is ignored by Git.
export SAIFE_PROJECT_DIR="$PWD"
export SAIFE_VENV_DIR="$SAIFE_PROJECT_DIR/venv"

# Leave empty to use Python already available in your shell.
# Otherwise set the exact module name provided by your cluster.
export SAIFE_PYTHON_MODULE=""

# Omit these settings to use your cluster's defaults. Command-line sbatch
# options override them, e.g. sbatch --partition=YOUR_PARTITION hpc/...
# export SBATCH_PARTITION="YOUR_PARTITION"
# export SBATCH_ACCOUNT="YOUR_ALLOCATION"
